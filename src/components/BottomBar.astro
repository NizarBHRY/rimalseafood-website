---
// Phone-only action bar: Call · Order · Directions · Menu.
import { business } from '../config/business';
---
<nav class="bottombar on-ink" aria-label="Quick actions">
  <a href={`tel:${business.phone.tel}`}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
    Call
  </a>
  <button type="button" popovertarget="order-sheet">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7z" /><path d="M9 7a3 3 0 0 1 6 0" /></svg>
    Order
  </button>
  <a href={business.mapsUrl} target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
    Directions<span class="visually-hidden"> (opens Google Maps)</span>
  </a>
  <a href="/menu">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14M5 12h14M5 19h14" /></svg>
    Menu
  </a>
</nav>

<style>
  .bottombar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    min-height: var(--bottombar-h);
    padding-bottom: env(safe-area-inset-bottom);
    border-top: 1px solid var(--brass);
  }
  .bottombar a, .bottombar button {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: 44px;
    border: 0;
    background: none;
    color: var(--sand);
    font-size: var(--fs-xs);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }
  .bottombar button { color: var(--ink); background: var(--saffron); font-weight: 600; }
  .bottombar svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  @media (min-width: 64rem) { .bottombar { display: none; } }
</style>
