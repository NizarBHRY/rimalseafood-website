---
import { business, hoursShort } from '../config/business';
---
<div class="topbar on-ink">
  <div class="wrap topbar-inner">
    <span>Open daily {hoursShort}</span>
    <span aria-hidden="true" class="dot">·</span>
    <a href={`tel:${business.phone.tel}`}>{business.phone.display}</a>
    <span aria-hidden="true" class="dot">·</span>
    <a href={business.mapsUrl} target="_blank" rel="noopener">Directions<span class="visually-hidden"> (opens Google Maps)</span></a>
  </div>
</div>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    font-size: var(--fs-xs);
    letter-spacing: 0.03em;
    border-bottom: 1px solid rgb(176 141 87 / 0.5);
  }
  .topbar-inner {
    min-height: var(--topbar-h);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s2);
    flex-wrap: wrap;
  }
  .topbar a { color: var(--sand); text-decoration: none; }
  .topbar a:hover { text-decoration: underline; }
  .dot { color: var(--brass); }
</style>
